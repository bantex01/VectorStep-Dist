# Copy to .env. install.sh writes this for you on a fresh install and never
# overwrites an existing one.

# Which GHCR image tag to pull. `latest` tracks the most recent release;
# `edge` tracks the default branch; or pin an exact version such as v0.1.0.
# This only selects the tag — it is NOT the app's self-reported version (that
# comes from VECTORSTEP_VERSION baked into the image at build time; see
# telemetry.md's note on the two never being the same variable).
VECTORSTEP_IMAGE_TAG=latest

# Anthropic API key, used by the Gateway's LLM provider.
ANTHROPIC_API_KEY=

# Bearer token VectorStep uses to authenticate to the Gateway. The Gateway
# generates this for itself on first boot; install.sh reads it out and fills
# this in automatically. Leave blank if you are not running the Gateway.
VECTORSTEP_GATEWAY_TOKEN=

# VectorStep itself requires a credential on every route (SPEC-auth-and-roles.md
# — see https://vectorstep.io/docs/operations/security/). install.sh generates
# both of these on a fresh install and writes the matching auth.tokens block
# into config/vectorstep.yaml. The admin token is also printed once at the end
# of install/upgrade — it's what you log into the UI with.
VECTORSTEP_ADMIN_TOKEN=
VECTORSTEP_WEBHOOK_TOKEN=

# Host ports. Change if these clash with something you already run.
VECTORSTEP_PORT=8000
# Unused unless you add a `ports:` entry back to the gateway service in
# docker-compose.yaml — the Gateway no longer publishes a host port by
# default (SPEC-tls-and-network.md §3.6). See this repo's README, "Reaching
# the Gateway from the host", if you need host access.
GATEWAY_PORT=18780

# Interface VectorStep's UI/API port binds to on the host. Loopback by
# default, so a fresh install never exposes an unauthenticated-by-default
# service to the local network. Set to 0.0.0.0 only when this host should
# serve other machines, and only once you've put TLS in front of it — either
# server.tls in config/vectorstep.yaml, or a terminating reverse proxy.
VECTORSTEP_BIND=127.0.0.1

# Only used when running the optional postgres profile.
POSTGRES_PASSWORD=vectorstep
